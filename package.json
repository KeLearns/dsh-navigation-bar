{
  "name": "@kelearns/dsh-navigation-bar",
  "description": "Piano-key style conversation navigation bar for the DeepSeek Harness web GUI: one key per user message with hover ladder animation, message-preview tooltip and active-message highlight. Official dual-face dsh plugin (host + client), mounted via the official plugin mechanism (dsh plugin add) — no dsh source changes.",
  "version": "0.2.1",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "navigation",
    "piano",
    "conversation"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md",
    "screenshots"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeLearns/dsh-navigation-bar.git"
  },
  "homepage": "https://github.com/KeLearns/dsh-navigation-bar",
  "bugs": {
    "url": "https://github.com/KeLearns/dsh-navigation-bar/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
